# Antarctic Twin Backend — Environment Variables
# Copy this file to .env and set real values before running.

PORT=4000
DATABASE_URL=sqlite:///./antarctic_twin.db
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=86400
PUBLIC_ENVIRONMENT_ENABLED=false
# Must be an official NCPOR/data.ncpor.res.in machine-readable endpoint.
PUBLIC_ENVIRONMENT_URL=
PUBLIC_ENVIRONMENT_REFRESH_SECONDS=900
PUBLIC_ENVIRONMENT_TIMEOUT_SECONDS=10
